{
	"name": "PL_trigger_main",
	"properties": {
		"activities": [
			{
				"name": "Until_all_process_completed",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('count_is_run_is_processed').output.firstRow.is_run_count,activity('count_is_run_is_processed').output.firstRow.is_processed_count)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "count_is_run_is_processed",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": "SELECT COUNT(is_run)  AS is_run_count ,\nCOUNT(CASE WHEN is_processed = 1 THEN 1 END) AS is_processed_count FROM metadata.ingestion_configuration WHERE is_run = 1",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_ingetion_config_table",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Wait_5min",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "count_is_run_is_processed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 60
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-07-27T19:40:58Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}