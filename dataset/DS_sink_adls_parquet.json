{
	"name": "DS_sink_adls_parquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "logistic_project_adls_LS",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"container_name": {
				"type": "string"
			},
			"sink_path": {
				"type": "string"
			},
			"file_name": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().file_name,'.parquet')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(dataset().sink_path,formatDateTime(utcNow(),'yyyy_MM_dd'))",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().container_name",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}